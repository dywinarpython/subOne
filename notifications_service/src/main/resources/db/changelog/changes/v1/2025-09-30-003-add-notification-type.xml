<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
    <changeSet id="2025-09-30-003-add-notification-type" author="Dywinar">
        <addColumn tableName="notifications">
            <column name="notification_type" type="varchar(20)"/>
            <column name="notification_target_type" type="varchar(20)"/>
            <column name="target_id" type="bigint"/>
        </addColumn>
        <dropColumn tableName="notifications" columnName="message"/>
    </changeSet>
</databaseChangeLog>