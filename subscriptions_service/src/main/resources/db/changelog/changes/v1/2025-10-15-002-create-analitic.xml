<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
    <changeSet id="2025-09-30-001-create-init-schema" author="Dywinar">
        <createTable tableName="analytic_subscriptions">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="subscription_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="date_paid" type="date">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="analytic_subscriptions" baseColumnNames="subscription_id"
                                 referencedTableName="user_subscriptions"
                                 referencedColumnNames="id"
                                 constraintName= "fk_analytic_subscriptions_user_subscriptions"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>